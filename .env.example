# ═══════════════════════════════════════════════════════════════════════════
# Langphy — environment template (TRACKED, NO REAL SECRETS)
# ═══════════════════════════════════════════════════════════════════════════
# How to use:
#   cp .env.example .env.local        # local Docker Compose (see LOCAL_DEV.md)
#   cp .env.example .env              # Railway deploy vars (dashboard uses these)
# Fill in the placeholder values. NEVER commit real secrets — the repo's
# .gitignore already rejects `.env` / `.env.local` / `**/*secrets*.yaml`.
#
# Local defaults are tuned for the in-compose KRaft broker (PLAINTEXT) and
# the docker-compose.local.yml / docker-compose.neon.yml stacks.
# ═══════════════════════════════════════════════════════════════════════════

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# MUST be exactly 64 lowercase hex chars — auth refuses to boot otherwise.
#   generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_KEY=REPLACE_WITH_64_HEX_CHARS
# Shared secret for speech-worker → nlp service-to-service calls.
# If empty, NLP requires a user JWT the worker can't provide — set it.
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_STRING
# CORS origin(s) allowed by auth + gateway (defaults to play.google.com)
CORS_ORIGIN=https://play.google.com

# ── PostgreSQL (Neon, per-service URLs — required) ─────────────────────────
AUTH_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_auth?sslmode=require
STREAKS_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_streaks?sslmode=require
PROGRESS_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_progress?sslmode=require
PERFORMANCE_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_performance?sslmode=require
PROFILE_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_profile?sslmode=require
SETTINGS_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_settings?sslmode=require
NOTIFICATION_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_notification?sslmode=require
GATEWAY_POSTGRES_DATABASE_URL=postgresql://user:pass@host:5432/langphy_gateway?sslmode=require
# Fallback only (used when the URL above is unset)
PG_PASSWORD=REPLACE_WITH_PG_PASSWORD
# PGDATA is a Railway self-hosted-postgres quirk — only set on Railway, not local.
# PGDATA=/var/lib/postgresql/data/pgdata

# ── Kafka — KRaft is in-compose; these are the LOCAL defaults ──────────────
KAFKA_BROKER=kafka:9092
# ⚠ Keep BOTH empty for local / in-project KRaft (plaintext broker).
#   Set REAL credentials only when pointing at a managed broker
#   (Confluent/Upstash) — the client ignores placeholder values like "dummy".
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/Langphy-DE?retryWrites=true&w=majority

# ── Redis (in-compose, local defaults; Railway uses ${{redis.RAILWAY_PRIVATE_DOMAIN}}) ─
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ── Speech / NLP ───────────────────────────────────────────────────────────
NLP_SERVICE_URL=http://nlp:8000
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_NUM_WORKERS=1
HF_HOME=/root/.cache/huggingface
# Only needed if you bake a gated HuggingFace model (not with the default
# public "small" Whisper model).
HF_TOKEN=

# ── Auth service providers / email ─────────────────────────────────────────
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
FROM_EMAIL=Langphy <no-reply@langphy.com>
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Reverse proxy (Caddy) upstream host/port map — must match compose ──────
PORT=80
AUTH_HOST=auth              AUTH_PORT=3000
STREAKS_HOST=streaks        STREAKS_PORT=3001
PROGRESS_HOST=progress      PROGRESS_PORT=3002
PERFORMANCE_HOST=performance PERFORMANCE_PORT=3003
PROFILE_HOST=profile        PROFILE_PORT=3004
SETTINGS_HOST=settings      SETTINGS_PORT=3005
NOTIFICATION_HOST=notification NOTIFICATION_PORT=4011
GATEWAY_HOST=gateway        GATEWAY_PORT=3009
CATEGORY_HOST=category      CATEGORY_PORT=4000
UNIT_HOST=unit              UNIT_PORT=4001
PRACTICE_HOST=practice      PRACTICE_PORT=4002
QUIZ_HOST=quiz              QUIZ_PORT=4003
SPEAKING_HOST=speaking      SPEAKING_PORT=4004
READING_HOST=reading        READING_PORT=4005
WRITING_HOST=writing        WRITING_PORT=4006
LISTENING_HOST=listening    LISTENING_PORT=4007
NLP_HOST=nlp                NLP_PORT=8000
SPEECH_API_HOST=speech-api  SPEECH_API_PORT=8001

# ── Content versioning (optional; code defaults to collection names + v1) ──
# CATEGORY_COLLECTION=categories        CATEGORY_CONTENT_VERSION=1
# UNIT_COLLECTION=units                 UNIT_CONTENT_VERSION=1
# PRACTICE_COLLECTION=practices         PRACTICE_CONTENT_VERSION=1
# QUIZ_COLLECTION=quizzes               QUIZ_CONTENT_VERSION=1
# SPEAKING_COLLECTION=speakings         SPEAKING_CONTENT_VERSION=1
# READING_COLLECTION=readings           READING_CONTENT_VERSION=1
# WRITING_COLLECTION=writings           WRITING_CONTENT_VERSION=1
# LISTENING_COLLECTION=listenings       LISTENING_CONTENT_VERSION=1

# ── Optional / legacy (referenced nowhere in code — safe to leave out) ─────
# OLLAMA_API_BASE=
# QSTASH_URL=
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=