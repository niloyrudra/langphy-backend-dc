{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@langphy/shared": ["../../shared/dist/index.d.ts"],
      "@langphy/shared/*": ["../../shared/dist/*"],
      "@shared/*": ["../../shared/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "jest.config.cjs"]
}
